class Persona:
    def __init__(self, cedula, nombre, email):
        self.cedula = cedula
        self.nombre = nombre
        self.email = email


class Profesor(Persona):
    def __init__(self, cedula, nombre, email, especialidad, materia):
        super().__init__(cedula, nombre, email)
        self.especialidad = especialidad
        self.materia = materia


class ProgramaAcademico:
    def __init__(self, nombre_programa):
        self.nombre_programa = nombre_programa


class Curso(ProgramaAcademico):
    pass


class Diplomado(ProgramaAcademico):
    pass


class Bootcamp(ProgramaAcademico):
    pass


class Alumno(Persona):
    def __init__(self, cedula, nombre, email, programa):
        super().__init__(cedula, nombre, email)
        self.programa = programa
        self.notas = []

    def registrar_nota(self, nota):
        self.notas.append(nota)

    def calcular_promedio(self):
        if not self.notas:
            return 0.0
        return sum(self.notas) / len(self.notas)


class SGA:
    def __init__(self):
        self.alumnos = []
        self.profesores = []
        self.cola_certificados = []
        self.pila_notas = []

    def guardar_alumnos_txt(self):
        try:
            f = open("Alumnos.txt", "w", encoding="utf-8")
            for a in self.alumnos:
                str_notas = ",".join(str(n) for n in a.notas) if a.notas else "Sin notas"
                linea = f"{a.cedula};{a.nombre};{a.email};{a.programa.nombre_programa};{str_notas}\n"
                f.write(linea)
            f.close()
        except Exception as err:
            print("Error con el archivo Alumnos.txt:", err)

    def registrar_profesor(self):
        print("\n--- Registro Profesor ---")
        ced = input("Cedula: ")
        nom = input("Nombre: ")
        email = input("Email: ")
        esp = input("Especialidad: ")
        mat = input("Materia: ")

        p = Profesor(ced, nom, email, esp, mat)
        self.profesores.append(p)
        print("Profesor registrado.")

    def registrar_alumno(self):
        print("\n--- Registro Alumno ---")
        ced = input("Cedula: ")
        nom = input("Nombre: ")
        email = input("Email: ")
        tipo = input("Tipo (curso/diplomado/bootcamp): ").lower()
        prog_nom = input("Nombre programa: ")

        if tipo == "curso":
            prog = Curso(prog_nom)
        elif tipo == "diplomado":
            prog = Diplomado(prog_nom)
        else:
            prog = Bootcamp(prog_nom)

        al = Alumno(ced, nom, email, prog)
        self.alumnos.append(al)
        
        self.guardar_alumnos_txt()
        print("Alumno guardado exitosamente.")

    def cargar_notas(self):
        print("\n--- Cargar Notas ---")
        ced = input("Ingrese la cedula del alumno: ")

        alumno_sel = None
        for a in self.alumnos:
            if a.cedula == ced:
                alumno_sel = a
                break

        if alumno_sel is None:
            print("Alumno no encontrado.")
            return

        print(f"Cargando notas para {alumno_sel.nombre} (max 3). Enter para terminar.")
        
        cant = len(alumno_sel.notas)
        mientras = True
        while cant < 3 and mientras:
            entrada = input(f"Nota {cant + 1}: ")
            if entrada == "":
                mientras = False
            else:
                try:
                    num = float(entrada)
                    alumno_sel.registrar_nota(num)
                    self.pila_notas.append((alumno_sel, num))
                    cant += 1
                except:
                    print("Nota invalida, ingrese un numero.")

        self.guardar_alumnos_txt()
        print("Notas guardadas y archivo Alumnos.txt actualizado.")

    def deshacer_nota(self):
        print("\n--- Deshacer Nota ---")
        if len(self.pila_notas) == 0:
            print("No hay notas registradas para eliminar.")
            return

        ult_alumno, ult_nota = self.pila_notas.pop()
        
        if ult_nota in ult_alumno.notas:
            ult_alumno.notas.remove(ult_nota)
            self.guardar_alumnos_txt()
            print(f"Se elimino la nota {ult_nota} de {ult_alumno.nombre} y se actualizo el txt.")

    def gestionar_certificados(self):
        print("\n--- EMISIÓN MASIVA DE CERTIFICADOS ---")
        if len(self.alumnos) == 0:
            print("Sin alumnos cargados.")
            return

        # Cargar a la cola a los alumnos aprobados (> 12)
        for a in self.alumnos:
            if a.calcular_promedio() > 12 and a not in self.cola_certificados:
                self.cola_certificados.append(a)

        if not self.cola_certificados:
            print("No hay alumnos aprobados pendientes por certificar.")
            return

        # Escribir la lista en certificados_pendientes.txt antes de procesar
        try:
            with open("certificados_pendientes.txt", "w", encoding="utf-8") as f:
                f.write("--- CERTIFICADOS PROCESADOS Y EMITIDOS ---\n")
                for i, c in enumerate(self.cola_certificados, 1):
                    f.write(f"{i}. Cedula: {c.cedula} | {c.nombre} | Promedio: {c.calcular_promedio():.2f} | Estatus: EMITIDO\n")
        except Exception as e:
            print("Error al escribir el archivo de certificados:", e)

        print(f"Se encontraron {len(self.cola_certificados)} alumno(s) aprobados.")
        
        # Procesar y emitir todos los certificados en bucle
        total_emitidos = 0
        while len(self.cola_certificados) > 0:
            alumno_emitido = self.cola_certificados.pop(0)
            print(f"-> Certificado emitido a: {alumno_emitido.nombre} (Cedula: {alumno_emitido.cedula})")
            total_emitidos += 1

        print(f"\nProceso finalizado. Se emitieron {total_emitidos} certificado(s) de una vez.")
        print("El archivo 'certificados_pendientes.txt' se ha actualizado.")

    def mostrar_reporte(self):
        print("\n--- REPORTE PROFESORES ---")
        if not self.profesores:
            print("Sin profesores registrados.")
        for p in self.profesores:
            print(f"Cedula: {p.cedula} | Nombre: {p.nombre} | Materia: {p.materia}")

        print("\n--- REPORTE ALUMNOS ---")
        if not self.alumnos:
            print("Sin alumnos registrados.")
        for a in self.alumnos:
            prom = a.calcular_promedio()
            est = "Aprobado" if prom > 12 else "Reprobado"
            print(f"Cedula: {a.cedula} | Nombre: {a.nombre} | Notas: {a.notas} | Promedio: {prom:.2f} ({est})")

    def menu(self):
        opc = ""
        while opc != "7":
            print("\n*** MENU SGA ***")
            print("1. Registrar Profesor")
            print("2. Registrar Alumno")
            print("3. Cargar Notas")
            print("4. Deshacer Ultima Nota")
            print("5. Emitir Todos los Certificados")
            print("6. Ver Reporte")
            print("7. Salir")
            
            opc = input("Opcion: ")

            if opc == "1":
                self.registrar_profesor()
            elif opc == "2":
                self.registrar_alumno()
            elif opc == "3":
                self.cargar_notas()
            elif opc == "4":
                self.deshacer_nota()
            elif opc == "5":
                self.gestionar_certificados()
            elif opc == "6":
                self.mostrar_reporte()
            elif opc == "7":
                print("Saliendo del programa...")
            else:
                print("Opcion no valida.")


if __name__ == "__main__":
    sistema = SGA()
    sistema.menu()