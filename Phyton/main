class Persona:
    def __init__(self, cedula, nombre, email):
        self.cedula = cedula
        self.nombre = nombre
        self.email = email


class Profesor(Persona):
    def __init__(self, cedula, nombre, email, especialidad, materia):
        super().__init__(cedula, nombre, email)
        self.especialidad = especialidad
        self.materia = materia


# --- POLIMORFISMO EN REGLAS DE APROBACIÓN ---
class ProgramaAcademico:
    def __init__(self, nombre_programa):
        self.nombre_programa = nombre_programa

    def es_aprobado(self, promedio):
        return promedio >= 10.0


class Curso(ProgramaAcademico):
    def es_aprobado(self, promedio):
        return promedio >= 10.0


class Diplomado(ProgramaAcademico):
    def es_aprobado(self, promedio):
        return promedio >= 12.0


class Bootcamp(ProgramaAcademico):
    def es_aprobado(self, promedio):
        return promedio >= 14.0


class Alumno(Persona):
    def __init__(self, cedula, nombre, email, programa):
        super().__init__(cedula, nombre, email)
        self.programa = programa
        self.notas = []

    def registrar_nota(self, nota):
        self.notas.append(nota)

    def calcular_promedio(self):
        if not self.notas:
            return 0.0
        return sum(self.notas) / len(self.notas)

    def esta_aprobado(self):
        prom = self.calcular_promedio()
        return self.programa.es_aprobado(prom)


class SGA:
    def __init__(self):
        self.alumnos = []
        self.profesores = []
        self.cola_certificados = []
        self.pila_notas = []
        
        # Carga inicial
        self.cargar_datos_iniciales()

    def cargar_datos_iniciales(self):
        """Lee el disco y refresca el estado en memoria con lo que haya en los .txt"""
        # Limpiar listas en memoria antes de recargar
        self.profesores.clear()
        self.alumnos.clear()

        # Cargar Profesores
        try:
            with open("Profesores.txt", "r", encoding="utf-8") as f:
                for linea in f:
                    linea_limpia = linea.strip()
                    if not linea_limpia:
                        continue
                    datos = [d.strip() for d in linea_limpia.split(";")]
                    if len(datos) >= 5:
                        p = Profesor(datos[0], datos[1], datos[2], datos[3], datos[4])
                        self.profesores.append(p)
        except FileNotFoundError:
            pass

        # Cargar Alumnos 
        try:
            with open("Alumnos.txt", "r", encoding="utf-8") as f:
                for linea in f:
                    linea_limpia = linea.strip()
                    if not linea_limpia:
                        continue
                    datos = [d.strip() for d in linea_limpia.split(";")]
                    if len(datos) >= 5:
                        ced, nom, email, tipo_prog, nom_prog = datos[0], datos[1], datos[2], datos[3], datos[4]
                        
                        # Recrear instancia polimórfica según el tipo guardado/editado
                        tipo_str = tipo_prog.lower()
                        if tipo_str == "curso":
                            prog = Curso(nom_prog)
                        elif tipo_str == "diplomado":
                            prog = Diplomado(nom_prog)
                        elif tipo_str == "bootcamp":
                            prog = Bootcamp(nom_prog)
                        else:
                            prog = Curso(nom_prog)

                        al = Alumno(ced, nom, email, prog)

                        # Parseo de notas (si existen)
                        if len(datos) >= 6 and datos[5] and datos[5] != "Sin notas":
                            str_notas = datos[5].split(",")
                            for n_str in str_notas:
                                try:
                                    al.registrar_nota(float(n_str.strip()))
                                except ValueError:
                                    pass  # Omite si el usuario escribió un texto inválido en las notas

                        self.alumnos.append(al)
        except FileNotFoundError:
            pass

    def guardar_alumnos_txt(self):
        try:
            with open("Alumnos.txt", "w", encoding="utf-8") as f:
                for a in self.alumnos:
                    str_notas = ",".join(str(n) for n in a.notas) if a.notas else "Sin notas"
                    tipo_prog = a.programa.__class__.__name__
                    linea = f"{a.cedula};{a.nombre};{a.email};{tipo_prog};{a.programa.nombre_programa};{str_notas}\n"
                    f.write(linea)
        except Exception as err:
            print("Error al guardar Alumnos.txt:", err)

    def guardar_profesores_txt(self):
        try:
            with open("Profesores.txt", "w", encoding="utf-8") as f:
                for p in self.profesores:
                    linea = f"{p.cedula};{p.nombre};{p.email};{p.especialidad};{p.materia}\n"
                    f.write(linea)
        except Exception as err:
            print("Error al guardar Profesores.txt:", err)

    def registrar_profesor(self):
        self.cargar_datos_iniciales()  # Sincroniza con disco
        print("\n--- Registro Profesor ---")
        ced = input("Cedula: ").strip()
        nom = input("Nombre: ").strip()
        email = input("Email: ").strip()
        esp = input("Especialidad: ").strip()
        mat = input("Materia: ").strip()

        p = Profesor(ced, nom, email, esp, mat)
        self.profesores.append(p)
        self.guardar_profesores_txt()
        print("Profesor registrado y guardado en archivo.")

    def registrar_alumno(self):
        self.cargar_datos_iniciales()  # Sincroniza con disco
        print("\n--- Registro Alumno ---")
        ced = input("Cedula: ").strip()
        nom = input("Nombre: ").strip()
        email = input("Email: ").strip()
        tipo = input("Tipo (curso/diplomado/bootcamp): ").strip().lower()
        prog_nom = input("Nombre programa: ").strip()

        if tipo == "curso":
            prog = Curso(prog_nom)
        elif tipo == "diplomado":
            prog = Diplomado(prog_nom)
        elif tipo == "bootcamp":
            prog = Bootcamp(prog_nom)
        else:
            print("Tipo no reconocido. Se asignara 'Curso' por defecto.")
            prog = Curso(prog_nom)

        al = Alumno(ced, nom, email, prog)
        self.alumnos.append(al)
        
        self.guardar_alumnos_txt()
        print("Alumno guardado exitosamente en Alumnos.txt.")

    def cargar_notas(self):
        self.cargar_datos_iniciales()  # Refresca por si modificaste notas o nombres a mano
        print("\n--- Cargar Notas ---")
        ced = input("Ingrese la cedula del alumno: ").strip()

        alumno_sel = None
        for a in self.alumnos:
            if a.cedula == ced:
                alumno_sel = a
                break

        if alumno_sel is None:
            print("Alumno no encontrado.")
            return

        print(f"Cargando notas para {alumno_sel.nombre} ({alumno_sel.programa.__class__.__name__}). Enter vacio para salir.")
        
        cant = len(alumno_sel.notas)
        mientras = True
        while cant < 3 and mientras:
            entrada = input(f"Nota {cant + 1}: ").strip()
            if entrada == "":
                mientras = False
            else:
                try:
                    num = float(entrada)
                    alumno_sel.registrar_nota(num)
                    self.pila_notas.append((alumno_sel, num))
                    cant += 1
                except ValueError:
                    print("Nota invalida, ingrese un numero.")

        self.guardar_alumnos_txt()
        print("Notas actualizadas en disco.")

    def deshacer_nota(self):
        self.cargar_datos_iniciales()  # Refresca archivo antes de eliminar
        print("\n--- Deshacer Nota ---")
        if len(self.pila_notas) == 0:
            print("No hay notas registradas en esta sesion para eliminar.")
            return

        ult_alumno, ult_nota = self.pila_notas.pop()
        
        # Buscar al alumno equivalente recargado de disco
        alumno_actual = None
        for a in self.alumnos:
            if a.cedula == ult_alumno.cedula:
                alumno_actual = a
                break

        if alumno_actual and ult_nota in alumno_actual.notas:
            alumno_actual.notas.remove(ult_nota)
            self.guardar_alumnos_txt()
            print(f"Se elimino la nota {ult_nota} de {alumno_actual.nombre} y se actualizo Alumnos.txt.")

    def gestionar_certificados(self):
        self.cargar_datos_iniciales()  # Refresca por si cambiaste notas a mano en Alumnos.txt
        print("\n--- EMISIÓN MASIVA DE CERTIFICADOS ---")
        if len(self.alumnos) == 0:
            print("Sin alumnos cargados.")
            return

        self.cola_certificados.clear()

        for a in self.alumnos:
            if a.esta_aprobado():
                self.cola_certificados.append(a)

        if not self.cola_certificados:
            print("No hay alumnos que cumplan las condiciones de aprobacion de su programa.")
            return

        try:
            with open("certificados_pendientes.txt", "w", encoding="utf-8") as f:
                f.write("--- CERTIFICADOS PROCESADOS Y EMITIDOS ---\n")
                for i, c in enumerate(self.cola_certificados, 1):
                    prom = c.calcular_promedio()
                    tipo = c.programa.__class__.__name__
                    f.write(f"{i}. Cedula: {c.cedula} | {c.nombre} | Prog: {tipo} ({c.programa.nombre_programa}) | Prom: {prom:.2f} | Estatus: EMITIDO\n")
        except Exception as e:
            print("Error al escribir el archivo de certificados:", e)

        print(f"Se encontraron {len(self.cola_certificados)} alumno(s) aprobados.")
        
        total_emitidos = 0
        while len(self.cola_certificados) > 0:
            alumno_emitido = self.cola_certificados.pop(0)
            tipo_prog = alumno_emitido.programa.__class__.__name__
            prom = alumno_emitido.calcular_promedio()
            print(f"-> Certificado emitido: {alumno_emitido.nombre} | {tipo_prog} | Promedio: {prom:.2f}")
            total_emitidos += 1

        print(f"\nProceso finalizado. Se emitieron {total_emitidos} certificado(s).")

    def mostrar_reporte(self):
        self.cargar_datos_iniciales()  # Sincroniza para mostrar datos editados externamente
        print("\n--- REPORTE PROFESORES ---")
        if not self.profesores:
            print("Sin profesores registrados.")
        for p in self.profesores:
            print(f"Cedula: {p.cedula} | Nombre: {p.nombre} | Materia: {p.materia}")

        print("\n--- REPORTE ALUMNOS ---")
        if not self.alumnos:
            print("Sin alumnos registrados.")
        for a in self.alumnos:
            prom = a.calcular_promedio()
            tipo_p = a.programa.__class__.__name__
            est = "Aprobado" if a.esta_aprobado() else "Reprobado"
            print(f"Cedula: {a.cedula} | Nombre: {a.nombre} | Programa: {tipo_p} ({a.programa.nombre_programa}) | Notas: {a.notas} | Promedio: {prom:.2f} ({est})")

    def menu(self):
        opc = ""
        while opc != "7":
            print("\n*** MENU SGA ***")
            print("1. Registrar Profesor")
            print("2. Registrar Alumno")
            print("3. Cargar Notas")
            print("4. Deshacer Ultima Nota")
            print("5. Emitir Todos los Certificados")
            print("6. Ver Reporte")
            print("7. Salir")
            
            opc = input("Opcion: ").strip()

            if opc == "1":
                self.registrar_profesor()
            elif opc == "2":
                self.registrar_alumno()
            elif opc == "3":
                self.cargar_notas()
            elif opc == "4":
                self.deshacer_nota()
            elif opc == "5":
                self.gestionar_certificados()
            elif opc == "6":
                self.mostrar_reporte()
            elif opc == "7":
                print("Saliendo del programa...")
            else:
                print("Opcion no valida.")


if __name__ == "__main__":
    sistema = SGA()
    sistema.menu()