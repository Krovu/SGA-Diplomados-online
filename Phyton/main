class Persona:
    def __init__(self, cedula, nombre, email):
        self.cedula = cedula
        self.nombre = nombre
        self.email = email

class Profesor(Persona):
    def __init__(self, cedula, nombre, email, especialidad, materia):
        super().__init__(cedula, nombre, email)
        self.especialidad = especialidad
        self.materia = materia

class ProgramaAcademico:
    def __init__(self):
        self.nombre_programa = self.__class__.__name__

    def es_aprobado(self, promedio, notas):
        return promedio >= 10.0

class Curso(ProgramaAcademico):
    def es_aprobado(self, promedio, notas):
        return promedio >= 10.0

class Diplomado(ProgramaAcademico):
    def es_aprobado(self, promedio, notas):
        return promedio >= 14.0

class Bootcamp(ProgramaAcademico):
    def es_aprobado(self, promedio, notas):
        if len(notas) < 3:
            return False
        for n in notas:
            if n < 14.0:
                return False
        return True

class Alumno(Persona):
    def __init__(self, cedula, nombre, email, programa):
        super().__init__(cedula, nombre, email)
        self.programa = programa
        self.notas = []

    def registrar_nota(self, nota):
        self.notas.append(nota)

    def calcular_promedio(self):
        if not self.notas:
            return 0.0
        return sum(self.notas) / 3.0

    def esta_aprobado(self):
        return self.programa.es_aprobado(self.calcular_promedio(), self.notas)

class NotaRegistro:
    def __init__(self, alumno, nota):
        self.alumno = alumno
        self.nota = nota

class SGA:
    def __init__(self):
        self.alumnos = []
        self.profesores = []
        self.pila_notas = []
        self.cargar_datos()

    def cargar_datos(self):
        self.profesores.clear()
        self.alumnos.clear()
        
        try:
            with open("Profesores.txt", "r", encoding="utf-8") as f:
                for linea in f:
                    l = linea.strip()
                    if not l: continue
                    d = [x.strip() for x in l.split(",")]
                    if len(d) >= 5:
                        self.profesores.append(Profesor(d[0], d[1], d[2], d[3], d[4]))
        except FileNotFoundError:
            pass

        try:
            with open("Alumnos.txt", "r", encoding="utf-8") as f:
                for linea in f:
                    l = linea.strip()
                    if not l: continue
                    d = [x.strip() for x in l.split(",")]
                    if len(d) >= 4:
                        ced, nom, email, tipo = d[0], d[1], d[2], d[3].lower()
                        prog = Bootcamp() if tipo == "bootcamp" else (Diplomado() if tipo == "diplomado" else Curso())
                        al = Alumno(ced, nom, email, prog)
                        if len(d) > 4:
                            for ns in d[4:]:
                                if ns:
                                    try:
                                        v = float(ns)
                                        if 0 <= v <= 20:
                                            al.registrar_nota(v)
                                    except ValueError:
                                        pass
                        self.alumnos.append(al)
        except FileNotFoundError:
            pass

    def guardar_alumnos(self):
        try:
            with open("Alumnos.txt", "w", encoding="utf-8") as f:
                for a in self.alumnos:
                    tipo = a.programa.__class__.__name__
                    partes = [a.cedula, a.nombre, a.email, tipo] + [str(n) for n in a.notas]
                    f.write(",".join(partes) + "\n")
        except Exception as e:
            print("Error guardando alumnos:", e)

    def guardar_profesores(self):
        try:
            with open("Profesores.txt", "w", encoding="utf-8") as f:
                for p in self.profesores:
                    f.write(f"{p.cedula},{p.nombre},{p.email},{p.especialidad},{p.materia}\n")
        except Exception as e:
            print("Error guardando profesores:", e)

    def registrar_profesor(self):
        self.cargar_datos()
        print("\n--- REGISTRAR PROFESOR ---")
        ced = input("Cedula: ").strip()
        for p in self.profesores:
            if p.cedula == ced:
                print("Ya existe un profesor con esa cedula.")
                return
        nom = input("Nombre: ").strip()
        email = input("Email: ").strip()
        esp = input("Especialidad: ").strip()
        mat = input("Materia: ").strip()
        
        self.profesores.append(Profesor(ced, nom, email, esp, mat))
        self.guardar_profesores()
        print("Profesor guardado.")

    def registrar_alumno(self):
        self.cargar_datos()
        print("\n--- REGISTRAR ALUMNO ---")
        ced = input("Cedula: ").strip()
        for a in self.alumnos:
            if a.cedula == ced:
                print("Error: Ya hay un alumno con esta cedula.")
                return
        nom = input("Nombre: ").strip()
        email = input("Email: ").strip()

        prog = None
        while not prog:
            t = input("Tipo (curso / diplomado / bootcamp): ").strip().lower()
            if t == "curso": prog = Curso()
            elif t == "diplomado": prog = Diplomado()
            elif t == "bootcamp": prog = Bootcamp()
            else: print("Tipo invalido, intenta de nuevo.")

        self.alumnos.append(Alumno(ced, nom, email, prog))
        self.guardar_alumnos()
        print("Alumno guardado con exito.")

    def cargar_notas(self):
        self.cargar_datos()
        print("\n--- CARGAR NOTAS (0 a 20) ---")
        ced = input("Cedula del alumno: ").strip()
        al = next((x for x in self.alumnos if x.cedula == ced), None)
        if not al:
            print("Alumno no encontrado.")
            return

        cant = len(al.notas)
        while cant < 3:
            txt = input(f"Nota {cant + 1} (Enter para salir): ").strip()
            if not txt: break
            try:
                val = float(txt)
                if 0 <= val <= 20:
                    al.registrar_nota(val)
                    self.pila_notas.append(NotaRegistro(al, val))
                    cant += 1
                else:
                    print("Nota fuera de rango (debe ser de 0 a 20).")
            except ValueError:
                print("Eso no es un numero valido.")
        
        self.guardar_alumnos()
        print("Notas guardadas.")

    def deshacer_nota(self):
        self.cargar_datos()
        if not self.pila_notas:
            print("No hay notas para deshacer.")
            return
        reg = self.pila_notas.pop()
        al = next((x for x in self.alumnos if x.cedula == reg.alumno.cedula), None)
        if al and reg.nota in al.notas:
            al.notas.remove(reg.nota)
            self.guardar_alumnos()
            print(f"Se quito la nota {reg.nota} de {al.nombre}.")

    def gestionar_certificados(self):
        self.cargar_datos()
        aprobados = [a for a in self.alumnos if a.esta_aprobado()]
        if not aprobados:
            print("No hay alumnos aprobados.")
            return

        try:
            with open("certificados_pendientes.txt", "w", encoding="utf-8") as f:
                f.write("=========================================\n\n")
                f.write("REPORTE DE CERTIFICADOS PENDIENTES\n\n")
                f.write("=========================================\n\n")
                f.write(f"Total de graduandos en cola: {len(aprobados)}\n\n")
                for i, c in enumerate(aprobados, 1):
                    f.write(f"{i}. [{c.cedula}] {c.nombre}\n\n")
                    f.write(f"- Programa: {c.programa.nombre_programa}\n\n")
                    f.write(f"- Promedio Final: {c.calcular_promedio():.1f}\n\n")
                    f.write("- Estatus: APROBADO\n\n")
        except Exception as e:
            print("Error al escribir certificados:", e)

        print(f"Se generó el reporte para {len(aprobados)} alumnos aprobados en 'certificados_pendientes.txt'.")

    def mostrar_reporte(self):
        self.cargar_datos()
        print("\n--- PROFESORES ---")
        if not self.profesores: print("Sin registros.")
        for p in self.profesores:
            print(f"{p.cedula} | {p.nombre} | {p.materia}")

        print("\n--- ALUMNOS ---")
        if not self.alumnos: print("Sin registros.")
        for a in self.alumnos:
            prom = a.calcular_promedio()
            est = "Aprobado" if a.esta_aprobado() else "Reprobado"
            print(f"{a.cedula} | {a.nombre} | {a.programa.nombre_programa} | Notas: {a.notas} | Prom: {prom:.1f} ({est})")

    def menu(self):
        op = ""
        while op != "7":
            print("\n*** MENU ***")
            print("1. Registrar Profesor")
            print("2. Registrar Alumno")
            print("3. Cargar Notas")
            print("4. Deshacer Ultima Nota")
            print("5. Emitir Certificados")
            print("6. Ver Reporte")
            print("7. Salir")
            op = input("Opcion: ").strip()

            if op == "1": self.registrar_profesor()
            elif op == "2": self.registrar_alumno()
            elif op == "3": self.cargar_notas()
            elif op == "4": self.deshacer_nota()
            elif op == "5": self.gestionar_certificados()
            elif op == "6": self.mostrar_reporte()
            elif op == "7": print("Saliendo...")
            else: print("Opcion no valida.")

if __name__ == "__main__":
    SGA().menu()